{
  "name": "giphy",
  "display": "Giphy 动图搜索 (墙内可达, 无需 key, 单查询约 36 张)",
  "driver": "http",
  "needs_proxy": false,
  "request": {
    "method": "GET",
    "url": "https://giphy.com/search/{query_encoded}",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8"
    },
    "pagination": {"type": "none"}
  },
  "parse": {
    "format": "html",
    "url_extract": {
      "patterns": [
        "https://giphy\\.com/gifs/[a-zA-Z0-9_-]+-([A-Za-z0-9]{10,})",
        "https://giphy\\.com/gifs/([A-Za-z0-9]{10,})"
      ]
    },
    "url_transform": [
      {"op": "regex_replace", "pattern": "^(.*)$", "repl": "https://media.giphy.com/media/\\1/giphy.gif"}
    ]
  },
  "item": {
    "url": {"path": "url"},
    "title": {"const": "{query}"},
    "referer": {"const": "https://giphy.com/"}
  }
}
