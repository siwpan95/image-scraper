{
  "name": "image-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "多源图片爬虫 · Cordis 插件化重构（一切皆插件）",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm start --workspace @scraper/cli",
    "story": "npm run start --workspace @scraper/cli --",
    "dump-config": "node apps/cli/scripts/dump-config.mjs"
  }
}
