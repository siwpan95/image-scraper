{
  "name": "pixabay_video",
  "display": "Pixabay 视频 (墙内可达, 无需 key, curl 绕过 CF)",
  "driver": "http",
  "fetch": "curl",
  "needs_proxy": false,
  "request": {
    "method": "GET",
    "url": "https://pixabay.com/zh/videos/search/{query_encoded}/?pagi={page}",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36",
      "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
      "Referer": "https://pixabay.com/"
    },
    "skip_empty_params": true,
    "pagination": {"type": "page", "param": null, "start": 1, "step": 1, "count_var": "pages", "delay": 3}
  },
  "parse": {
    "format": "html",
    "url_extract": {
      "patterns": [
        "https://cdn\\.pixabay\\.com/video/\\d{4}/\\d{2}/\\d{2}/\\d+-\\d+_"
      ]
    },
    "url_transform": [
      {"op": "regex_replace", "pattern": "_$", "repl": "_large.mp4"}
    ]
  },
  "item": {
    "url": {"path": "url"},
    "title": {"const": "{query}"},
    "author": {"const": ""},
    "referer": {"const": "https://pixabay.com/"}
  }
}
